# ============================================================
# Admin Auth
# ============================================================

# Secret used to sign admin auth cookies (stateless — no session store).
# Generate with: openssl rand -hex 32
# Required — admin login will fail if unset.
ADMIN_SECRET=

# Secret shared between middleware and the internal whitelist-check route.
# Prevents the check endpoint from being called directly by outside clients.
# Generate with: openssl rand -hex 32
# Required — whitelist feature will fail if unset.
INTERNAL_SECRET=

# ============================================================
# IP Access Control
# ============================================================

# Set to "true" to completely disable the IP whitelist check.
# Useful during local development or as an emergency override if you've locked
# yourself out. NEVER leave this enabled in production — it removes all IP-based
# access control.
# Default: unset (IP check is enforced)
ADMIN_DISABLE_IP_CHECK=

# Pre-shared bypass token for IP-independent admin access.
# Use this when connecting from cellular data or any network where your IP is
# dynamic and impractical to whitelist.
#
# How to use:
#   1. Generate a strong token: openssl rand -hex 32
#   2. Set it here and restart the server
#   3. Bookmark this URL on your devices:
#      https://your-domain.com/api/admin/auth/bypass?t=YOUR_TOKEN
#   4. When on cellular, visit the bookmark → you receive a 24-hour bypass
#      cookie → then log in normally with your password.
#
# Security notes:
#   - The bypass cookie is cryptographically signed with ADMIN_SECRET
#   - It expires after 24 hours
#   - This is the correct alternative to MAC address whitelisting
#     (MAC addresses do not cross the internet — they are Layer 2 only)
#
# Required to use the bypass feature. Leave blank to disable it.
ADMIN_BYPASS_TOKEN=

# ============================================================
# GitHub Webhook / Auto-deploy
# ============================================================

# Secret set in your GitHub repo's webhook settings (Payload secret field).
WEBHOOK_SECRET=

# Branch that triggers a deployment. Pushes to any other branch are ignored.
# Defaults to "main" if unset.
DEPLOY_BRANCH=main

# Absolute path to the repo on the server.
# Defaults to ~/ps15642.com-nextJS (current user's home dir) if unset.
DEPLOY_DIR=

# Path to your nvm installation directory.
# Defaults to ~/.nvm (current user's home dir) if unset.
#
# Why this is needed:
#   exec() spawns a bare, non-login shell — .bashrc and .bash_profile never run,
#   so nvm is never initialized and `node`/`npm` are not on PATH.
#   The deploy command works around this by sourcing nvm.sh directly from this
#   directory, which bootstraps nvm without needing a login shell.
#
# Upgrading Node:
#   Run `nvm install <version> && nvm alias default <version>` on the server.
#   The next deploy will automatically use the new version — no config changes needed.
NVM_DIR=

# ============================================================
# Gallery Backups
# ============================================================

# Where dated .zip backups of public/gallery/ are stored.
# Should be outside the repo so it survives deploys.
# Defaults to ~/gallery-backups (current user's home dir) if unset.
BACKUP_DIR=

# How many weeks of backups to retain before old ones are pruned.
# Defaults to 12 (3 months) if unset.
BACKUP_KEEP_WEEKS=12

# ============================================================
# Admin Panel Backups (Backup & Restore tab)
# ============================================================

# Where admin-created backups are stored (gallery + articles, directory-per-backup).
# Must be an absolute path. Defaults to <repo>/data/backups if unset.
# Note: data/ is in .gitignore, so backups are never committed.
ADMIN_BACKUP_DIR=

# Maximum total disk space all admin backups may use, in megabytes.
# The UI will refuse to create new backups when this limit would be exceeded.
# Defaults to 500 (MB) if unset.
ADMIN_BACKUP_SIZE_LIMIT_MB=500
