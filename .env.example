# Absolute path to the gallery images directory.
# Set this to a folder OUTSIDE the repo so photos are never committed to git.
# During build, Next.js copies images from this path into public/_gallery for serving.
#
# Example (Linux/production):
#   GALLERY_DIR=/home/ubuntu/gallery
#
# If unset, defaults to:
#   production → /home/ubuntu/public/ps15642.com-nextJS/public/gallery
#   development → <repo>/public/gallery
GALLERY_DIR=

# GitHub webhook secret — must match the secret set in your GitHub repo's webhook settings.
WEBHOOK_SECRET=

# Branch that triggers a deployment. Pushes to any other branch are ignored.
# Defaults to "main" if unset.
DEPLOY_BRANCH=main

# Absolute path to the repo on the server.
# Defaults to /home/ubuntu/ps15642.com-nextJS if unset.
DEPLOY_DIR=

# Path to your nvm installation directory.
# Defaults to /home/ubuntu/.nvm if unset.
# exec() runs a non-login shell so nvm isn't on PATH automatically —
# the deploy command sources nvm.sh from this directory instead.
NVM_DIR=
